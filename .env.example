# Required for a shared deployment. Free key: https://console.groq.com/keys
# Covers both the interview model and speech-to-text.
# Leave empty to make every visitor bring their own key in Settings.
GROQ_API_KEY=

# Optional fallback for chat when Groq is rate limited. Free key: https://aistudio.google.com/apikey
# Speech-to-text has no fallback.
GEMINI_API_KEY=

# Requests per hour, per visitor, on the shared key. A session uses roughly 20.
RATE_LIMIT_PER_HOUR=60

# Optional model overrides. Check https://console.groq.com/docs/models before changing these.
# GROQ_MODEL_FAST=openai/gpt-oss-20b
# GROQ_MODEL_DEEP=openai/gpt-oss-120b
# GROQ_MODEL_STT=whisper-large-v3-turbo
# GEMINI_MODEL=gemini-3.8-flash

# Runs the app on scripted replies with no key. For local UI work and the test suites only.
# LLM_PROVIDER=mock
